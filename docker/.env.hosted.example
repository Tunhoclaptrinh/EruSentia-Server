# Copy to .env.hosted.local (ignored). Generate three DIFFERENT random hex secrets.
PROJECT_COMPOSE_NAME=erusentia-hosted
PROJECT_DB_PASSWORD=
PROJECT_RABBIT_PASSWORD=
PROJECT_JWT_SECRET=
# DNS A record must point to this VM. Use a hostname only, without https:// or path.
HOSTED_API_DOMAIN=
# Browser origin only; no path, wildcard or trailing /app/.
PROJECT_CORS_ORIGINS=https://tunhoclaptrinh.github.io
HOSTED_SWAGGER_ENABLED=false
