# ==============================================================================
# ENVIRONMENT CONFIGURATION (EXAMPLE - SAFE FOR PUBLIC REPO)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application
NODE_ENV=development
APP_NAME=sentia-hub-service

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_dev_password
DB_DATABASE=sentia_hub_db
DB_POOL_MIN=5
DB_POOL_MAX=20
