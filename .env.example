# ==============================================================================
# ENVIRONMENT CONFIGURATION (EXAMPLE - SAFE FOR PUBLIC REPO)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application
NODE_ENV=development
APP_NAME=sentia-hub-service
HOST=127.0.0.1
PORT=3001
# postgres (default) or memory (demonstration; no DB connection)
TEMPLATE_STORE=postgres
# Swagger UI /docs and OpenAPI /docs-json; default off when NODE_ENV=production
# SWAGGER_ENABLED=true

# Authentication
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=your-generated-random-key
# Required in production (at least 32 bytes); absent in development uses a temporary key.
# Access JWT: 15 minutes; absolute refresh-family lifetime: 7 days.

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_dev_password
DB_DATABASE=sentia_hub_db
DB_POOL_MIN=5
DB_POOL_MAX=20

# Week 4: optional welcome-email queue (PostgreSQL only).
# Run pnpm db:queue before enabling; start the worker in another terminal.
QUEUE_ENABLED=false
AMQP_URL=amqp://eru:eru_dev_password@127.0.0.1:5672
QUEUE_NAMESPACE=erusentia
QUEUE_RETRY_DELAY_MS=5000
# Local Mailpit SMTP sink only; no external email provider configured.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
