# ==============================================================================
# ENVIRONMENT CONFIGURATION (EXAMPLE - SAFE FOR PUBLIC REPO)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application
NODE_ENV=development
PORT=3000
APP_NAME=sentia-hub-service
API_PREFIX=/api/v1

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_dev_password
DB_DATABASE=sentia_hub_db
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Cache (Phase 2 / Week 5)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Phase 2 / Week 4)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & Auth (Week 3)
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
