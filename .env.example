# ==============================================================================
# ENVIRONMENT CONFIGURATION (EXAMPLE - SAFE FOR PUBLIC REPO)
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# Application
NODE_ENV=development
APP_NAME=sentia-hub-service
HOST=127.0.0.1
PORT=3001
# postgres (default) or memory (demonstration; no DB connection)
TEMPLATE_STORE=postgres
# Swagger UI /docs and OpenAPI /docs-json; default off when NODE_ENV=production
# SWAGGER_ENABLED=true

# Authentication
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=your-generated-random-key
# Required in production (at least 32 bytes); absent in development uses a temporary key.
# Access JWT: 15 minutes; absolute refresh-family lifetime: 7 days.

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_dev_password
DB_DATABASE=sentia_hub_db
# Hosted PostgreSQL: true enables TLS with certificate/hostname verification.
# Neon: use the direct hostname (without -pooler) for project migrations.
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=20

# Week 4: optional welcome-email queue (PostgreSQL only).
# Run pnpm db:queue before enabling; start the worker in another terminal.
QUEUE_ENABLED=false
AMQP_URL=amqp://eru:eru_dev_password@127.0.0.1:5672
QUEUE_NAMESPACE=erusentia
QUEUE_RETRY_DELAY_MS=5000
# Local Mailpit SMTP sink only; no external email provider configured.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Week 5: optional public Template cache (PostgreSQL only).
# Apply pnpm db:cache before enabling; Redis outage falls back to PostgreSQL.
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
CACHE_NAMESPACE=erusentia
CACHE_TTL_SECONDS=60

# Project integration: exact web origins, comma-separated. Default in development:
# http://localhost:5173,http://127.0.0.1:5173
# Production default: no cross-origin access. Empty value disables the allowlist.
# CORS_ORIGINS=https://your-app.example

# Optional account verification/reset: disabled on hosted services. Local Mailpit only.
ACCOUNT_EMAIL_MODE=disabled
ACCOUNT_EMAIL_APP_URL=http://127.0.0.1:5173

# C4 service limits. Applies to server resources; local notes stay unlimited here.
API_RATE_LIMITS_ENABLED=true
AUTH_LOGIN_PER_IP=200
AUTH_LOGIN_PER_IDENTITY=20
AUTH_REGISTER_PER_IP=40
AUTH_REFRESH_PER_IP=300
API_WRITES_PER_USER=60
TEMPLATE_QUOTA_COUNT=100
TEMPLATE_QUOTA_CONTENT_BYTES=20971520
# Logical retained template payloads and all revision snapshots, including trash.
TEMPLATE_RETAINED_COUNT=500
TEMPLATE_RETAINED_REVISIONS=10000
TEMPLATE_RETAINED_BYTES=209715200
REPORT_RETAINED_COUNT=1000
# Trust forwarded client IP only after verifying every ingress path/proxy.
TRUST_PROXY_HOPS=0
