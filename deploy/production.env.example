# Copy to docker/.env.hosted.local (ignored). Used only on a trusted local machine.
# API: HTTPS origins below are examples. Replace with your actual deployments.
NODE_ENV=production
TEMPLATE_STORE=postgres
DB_HOST=ep-your-project.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_USERNAME=your_neon_role
DB_PASSWORD=replace_locally
DB_DATABASE=eru_project_render
DB_SSL=true
DB_POOL_MAX=5
JWT_SECRET=replace_with_a_stable_random_secret_at_least_32_bytes
CORS_ORIGINS=https://eru-sentia.vercel.app,https://your-admin.vercel.app,https://tunhoclaptrinh.github.io
RESOURCE_TARGET_ORIGINS=https://your-api.onrender.com
RESOURCE_GATEWAY_ENABLED=true
QUEUE_ENABLED=false
CACHE_ENABLED=false
TRUST_PROXY_HOPS=1
ACCOUNT_EMAIL_MODE=disabled
PROJECT_DEMO_ACCOUNTS=false
PROJECT_COMMUNITY_DEMO=true
PROJECT_BOOTSTRAP=true
