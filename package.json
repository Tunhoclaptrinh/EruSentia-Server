{
  "name": "sentia-hub-service",
  "version": "1.0.0",
  "description": "Sentia Hub - High-performance Cloud Community & Template Sharing Backend Service",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:check": "node --import tsx src/main.ts",
    "db:schema": "node --import tsx scripts/run-sql.ts sql/01_schema.sql",
    "db:indexes": "node --import tsx scripts/run-sql.ts sql/02_indexes.sql",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:reset": "node --import tsx scripts/run-sql.ts sql/00_reset.sql",
    "db:fresh": "pnpm db:reset && pnpm db:schema && pnpm db:indexes && pnpm db:seed",
    "db:benchmark": "node --import tsx scripts/benchmark.ts",
    "demo:oop": "node --import tsx src/week01-practice/oop/demo.ts",
    "demo:di": "node --import tsx src/week01-practice/di/demo.ts",
    "test": "node --test test/*.test.cjs",
    "test:watch": "node --test --watch test/*.test.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "playwright": "^1.63.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
